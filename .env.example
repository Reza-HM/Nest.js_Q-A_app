PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/askhub?schema=public"

# Authentication
JWT_ACCESS_SECRET="example_jwt_access_secret_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="example_jwt_refresh_secret_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"
